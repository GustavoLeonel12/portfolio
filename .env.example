# =====================================================================
#  Chatbot de IA — configuracao do BACKEND
#  Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
#  O arquivo ".env" NAO deve ser versionado (ja esta no .gitignore).
#
#  A API KEY e lida apenas pelo backend (server/). O frontend nunca recebe
#  essa credencial: ele conversa somente com /api/chat.
# =====================================================================

# --- Provedor de IA ---
# Aceitos: openai | gemini | anthropic
AI_PROVIDER=openai

# --- Credencial (obrigatoria) ---
AI_API_KEY=

# --- Modelo ---
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-2.0-flash
#   anthropic -> claude-3-5-haiku-latest
AI_MODEL=gpt-4o-mini

# --- Somente para provedores "openai-compatible" ---
# Deixe vazio para usar a OpenAI. Exemplos:
#   OpenRouter -> https://openrouter.ai/api/v1
#   Groq        -> https://api.groq.com/openai/v1
#   Ollama      -> http://localhost:11434/v1
#   LM Studio   -> http://localhost:1234/v1
AI_BASE_URL=

# --- Ajuste de comportamento ---
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=600
AI_TIMEOUT_MS=25000

# --- Contexto e seguranca ---
# Quantas mensagens anteriores vao para o modelo a cada resposta
CHAT_HISTORY_TURNS=12
# Tamanho maximo de uma mensagem do usuario
CHAT_MAX_MESSAGE_LENGTH=2000
# Requisicoes por minuto por sessao
CHAT_RATE_LIMIT=20

# --- Porta do backend ---
PORT=8787
